# ─────────────────────────────────────────
# LLM Provider 설정
#   mock   — API Key 없이 동작 (개발/테스트용)
#   openai — OpenAI ChatCompletion 사용
#   gemini — Google Gemini 사용
#   claude — Anthropic Claude 사용
# ─────────────────────────────────────────
LLM_PROVIDER=mock

# 실제 API Key (mock 모드에서는 비워두어도 됨)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────
# OpenSearch (Risk Analysis Module와 동일 값)
# ─────────────────────────────────────────
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=VulnScanner_2026!@#

# ─────────────────────────────────────────
# 보고서 출력 언어: ko | en | zh
# ─────────────────────────────────────────
REPORT_LANGUAGE=ko

# ─────────────────────────────────────────
# API Server 설정
# ─────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
